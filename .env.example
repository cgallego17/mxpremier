# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=mxbaseball.com,www.mxbaseball.com
CSRF_TRUSTED_ORIGINS=https://mxbaseball.com,https://www.mxbaseball.com

# Facebook Graph API
FB_GRAPH_API_VERSION=v25.0
FB_PAGE_ID=your-page-id
FB_PAGE_ACCESS_TOKEN=your-access-token
FB_REELS_LIMIT=3
FB_PAGE_URL=https://www.facebook.com/MXpremierbaseball
FB_REELS_URL=https://www.facebook.com/MXpremierbaseball/reels/

# Rate limiting (registro)
REGISTRO_RATE_LIMIT=5
REGISTRO_RATE_WINDOW=3600
